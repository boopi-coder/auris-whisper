{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auris Whisper",
  "mainBinaryName": "auris-whisper",
  "version": "2.3.0",
  "identifier": "ru.boopi.auriswhisper",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Auris Whisper",
        "width": 920,
        "height": 780,
        "minWidth": 720,
        "minHeight": 620,
        "center": true,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/ggml-silero-v5.1.2.bin": "resources/ggml-silero-v5.1.2.bin"
    },
    "publisher": "boopi.site",
    "homepage": "https://boopi.site",
    "copyright": "© 2026 boopi.site — MIT License",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "Productivity",
    "shortDescription": "Offline speech-to-text",
    "longDescription": "Offline speech-to-text on whisper.cpp. Drop an audio or video file or dictate — get clean text. Nothing leaves your computer.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libvulkan1",
          "libasound2t64 | libasound2",
          "libayatana-appindicator3-1"
        ],
        "recommends": [
          "ffmpeg"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5QzYwNkJDNTg5RjFEQzAKUldUQUhaOVl2QWJHaVp0bk0xYTNnTkVkUWFTeFdmb2ZZZW9WUjR1Q1VIYkxBOGw5dHlXcWQvN0kK",
      "endpoints": [
        "https://github.com/boopi-coder/auris-whisper/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
